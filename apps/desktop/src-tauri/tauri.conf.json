{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bolo",
  "identifier": "dev.bolo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bolo Settings",
        "width": 980,
        "height": 700,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      },
      {
        "label": "pill",
        "title": "Bolo",
        "url": "pill.html",
        "width": 560,
        "height": 72,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
