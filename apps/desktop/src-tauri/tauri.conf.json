{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bolo",
  "identifier": "dev.bolo.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "pill",
        "title": "Bolo",
        "url": "pill.html",
        "width": 560,
        "height": 72,
        "visible": false,
        "focus": false,
        "focusable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNzUwRDNGNjBGQ0NCNEEKUldSS3kveGdQdzExWThDMld4RGVKNjhXQkVQd04vZ1Jkd0tkTmo4clFZUWVwNEVPMnBGUjlRRlEK",
      "endpoints": ["https://github.com/Nirav1810/bolo/releases/latest/download/latest.json"],
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Bolo contributors",
    "copyright": "MIT OR Apache-2.0",
    "shortDescription": "Hold a key, speak, and the text lands in the app you're in",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../../../.cache/sherpa-lib/onnxruntime.dll": "onnxruntime.dll",
      "../../../.cache/sherpa-lib/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "../../../.cache/sherpa-lib/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "../../../.cache/sherpa-lib/sherpa-onnx-cxx-api.dll": "sherpa-onnx-cxx-api.dll"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
