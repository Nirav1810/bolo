# Bolo developer keys — read automatically by bolo-bench from the project folder.
# Keep this file private: it is git-ignored. Paste each key after the "=" with no quotes or spaces.
# (The finished apps store keys in Windows Credential Manager / Android Keystore instead.)

# Deepgram (speech-to-text): https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic / Claude (text cleanup, --polish): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional, only if you get these later:
# GROQ_API_KEY=
# SARVAM_API_KEY=
